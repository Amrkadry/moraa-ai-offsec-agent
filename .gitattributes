# Force LF line endings for executable scripts regardless of platform autocrlf settings —
# CRLF breaks #!/usr/bin/env shebangs when run under WSL/Linux (the standing execution
# environment for this skill set).
scripts/*.sh text eol=lf
scripts/*.py text eol=lf
scripts/**/*.sh text eol=lf
scripts/**/*.py text eol=lf
tests/*.py text eol=lf
tests/**/*.py text eol=lf
templates/*.yaml text eol=lf
templates/**/*.yaml text eol=lf
